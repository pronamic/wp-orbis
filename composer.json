{
	"name": "pronamic/wp-orbis",
	"description": "Orbis is a powerful, extendable plugin to boost up your business. Project Management, Customer Relation Management & More…",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"orbis",
		"wordpress",
		"plugin",
		"bootstrap"
	],
	"homepage": "http://www.happywp.com/plugins/orbis/",
	"authors": [
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl",
			"role": "Developer"
		},
		{
			"name": "Karel-Jan Tolsma",
			"email": "info@kareljantolsma.nl",
			"homepage": "http://www.kareljantolsma.nl",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@pronamic.nl",
		"issues": "https://github.com/pronamic/wp-orbis/issues",
		"source": "https://github.com/pronamic/wp-orbis"
	},
	"type": "wordpress-plugin",
	"autoload": {
		"classmap": [
			"classes/"
		]
	},
	"config": {
		"platform": {
			"php": "8.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"wp-slug": "orbis"
	},
	"require": {
		"php": ">=8.0",
		"pronamic/wp-money": "^2.4",
		"phpoffice/phpspreadsheet": "^1.29",
		"tecnickcom/tcpdf": "^6.2",
		"sabre/vobject": "^4.1",
		"giggsey/libphonenumber-for-php": "^8.10",
		"automattic/jetpack-autoloader": "^3.0"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"deployer/deployer": "^7.5"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/orbis",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis/",
			"vendor/bin/wp i18n make-pot ./build/orbis/ --slug=orbis",
			"vendor/bin/wp i18n make-mo ./build/orbis/languages/",
			"vendor/bin/wp dist-archive ./build/orbis/ --plugin-dirname=orbis --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"qa": [
			"@phpcs"
		]
	}
}
